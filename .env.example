# Port the server listens on
PORT=3000

# SQLite database file (created automatically)
DB_PATH=./data/quotes.db

# External quote API (must return JSON with "quote", "author" and "id")
QUOTE_API_URL=https://dummyjson.com/quotes/random

# Milliseconds to wait for the external API before giving up
QUOTE_API_TIMEOUT_MS=5000
